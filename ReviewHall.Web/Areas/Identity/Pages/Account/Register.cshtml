@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
    // Check if external logins exist to adjust layout
    var hasExternalLogins = (Model.ExternalLogins?.Count ?? 0) > 0;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">

        <div class="p-4 p-md-5 bg-white border rounded-3 shadow-lg auth-container">
            <h1 class="text-center mb-4 fw-bold text-pink-dark">
                <i class="bi bi-person-plus-fill me-2"></i> @ViewData["Title"]
            </h1>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <h2 class="h5 mb-3 fw-semibold text-center text-secondary">
                    Create your new Library account
                </h2>

                <hr class="mb-4" />

                <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-grid mb-3">
                    <button id="registerSubmit" type="submit" class="btn btn-lg btn-pink fw-bold">Register</button>
                </div>

                <p class="text-center small mt-3">
                    Already have an account? <a asp-page="./Login" class="text-pink">Log in here</a>.
                </p>
            </form>
        </div>

        @if (hasExternalLogins)
        {
            <div class="mt-4 p-4 bg-light-pink-bg border rounded-3 shadow-sm text-center">
                <section>
                    <h3 class="h6 fw-semibold text-pink-dark">Or register using:</h3>
                    <hr class="my-3" />

                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary m-1" name="provider" value="@provider.Name" title="Register using your @provider.DisplayName account">
                                    <i class="bi bi-globe me-1"></i> @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                </section>
            </div>
        }
        else
        {
            <div class="mt-4 text-center small text-muted">
                <p>No external authentication services configured.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}