@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">

        <div class="p-4 p-md-5 bg-white border rounded-3 shadow-lg auth-container">
            <h1 class="text-center mb-4 fw-bold text-pink-dark">
                <i class="bi bi-question-circle-fill me-2"></i> @ViewData["Title"]
            </h1>

            <h2 class="h5 mb-3 fw-semibold text-center text-secondary">
                Enter your email address to receive a password reset link.
            </h2>
            <hr class="mb-4" />

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-lg btn-pink fw-bold">Send Reset Link</button>
                </div>
            </form>

            <p class="text-center small mt-3">
                <a asp-page="./Login" class="text-pink">Return to Login</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}