@model ReviewHall.Core.Models.HomeViewModel

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Welcome to the Review Book Hall";
}

<div class="container my-4">
    <div class="p-4 bg-white border rounded-3 shadow-lg home-card">

        <div class="row">
            <div class="col-lg-8">
                <h1 class="text-pink-dark mb-4 fw-bold display-5">
                    <i class="bi bi-star-fill me-2"></i><strong>Highest Rated Books</strong>
                </h1>

                <h2 class="h5 text-secondary fw-normal mb-4">
                    Check out the top-rated books based on community reviews!
                </h2>

                @if (Model != null && Model.FeaturedBooks != null && Model.FeaturedBooks.Any())
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                        @foreach (var book in Model.FeaturedBooks)
                        {
                            <div class="col">
                                <div class="card h-100 book-card text-center">
                                    <a href="javascript:void(0);" onclick="openDetailsModal('@book.BookId')">
                                        <img src="@book.CoverImageUrl"
                                             class="book-cover"
                                             alt="@book.Title"
                                             onerror="this.onerror=null; this.src='https://placehold.co/400x200/FADADD/333?text=No+Cover';" />
                                    </a>
                                    <div class="card-body">
                                        <h5 class="card-title book-title-text text-truncate fw-bold" title="@book.Title">@book.Title</h5>
                                        <p class="card-text small text-muted mb-1">by @book.AuthorName</p>
                                        <p class="text-warning mb-0">
                                            <i class="bi bi-star-fill"></i> @book.AverageRating.ToString("F2")
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info bg-light-pink-bg border-pink-light mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        No <strong>featured books</strong> yet. <a asp-controller="Book" asp-action="Index" class="text-pink fw-bold">Be the first to review!</a>
                    </div>
                }

                <div class="text-center mt-4">
                    <a asp-controller="Book" asp-action="Index" class="btn btn-lg btn-pink-custom">
                        View All Books & Reviews <i class="bi bi-arrow-right-short ms-2"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-4 border-start ps-lg-4 mt-5 mt-lg-0">
                <h3 class="text-pink-dark h5 fw-bold mb-3">Review Hall Stats 📊</h3>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item bg-light-pink-bg d-flex justify-content-between align-items-center">
                        Total Books in Hall:
                        <span class="badge bg-pink-custom">@Model.TotalBooks</span>
                    </li>
                    <li class="list-group-item bg-light-pink-bg d-flex justify-content-between align-items-center">
                        Total Reviews Posted:
                        <span class="badge bg-pink-custom">@Model.TotalReviews</span>
                    </li>
                    <li class="list-group-item bg-light-pink-bg d-flex justify-content-between align-items-center">
                        Overall Average Rating:
                        <span class="badge bg-warning text-dark">
                            @Model.OverallAverageRating.ToString("F2") <i class="bi bi-star-fill align-middle" style="color:#ffc107;"></i>
                        </span>
                    </li>
                    <li class="list-group-item bg-light-pink-bg d-flex justify-content-between align-items-center">
                        Total Reviewers:
                        <span class="badge bg-pink-custom">@Model.TotalMembers</span>
                    </li>
                </ul>

                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="text-pink-dark fw-bold mb-3">
                                <i class="bi bi-person-circle me-2"></i>Welcome Back!
                            </h5>
                            <p class="text-muted mb-3">
                                Logged in as <strong>@User.Identity?.Name</strong>
                            </p>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-pink-custom w-100 mb-2">
                                    <i class="bi bi-book me-1"></i> Manage Books (Admin)
                                </a>
                            }
                            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-sm btn-outline-secondary w-100">
                                <i class="bi bi-person-fill me-1"></i> Manage Account
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <h5 class="text-pink-dark fw-bold mb-3">
                                <i class="bi bi-heart-fill me-2"></i>Join the Hall!
                            </h5>
                            <a asp-area="Identity" asp-page="/Account/Register"
                               class="btn btn-lg btn-pink-custom w-100 mb-2">
                                <i class="bi bi-person-plus me-2"></i><strong>Create Free Reviewer Account</strong>
                            </a>
                            <p class="text-muted small mb-3">It only takes a minute!</p>
                            <a asp-area="Identity" asp-page="/Account/Login" class="text-pink fw-bold small">
                                Already have an account? Login here
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showMessage(message) {
            alert(message);
        }

        function showModal(html, title = 'Book Details') {
            // Remove existing modal if any
            const existingModal = document.getElementById('bookModal');
            if (existingModal) {
                existingModal.remove();
            }

            const modalHtml = `
                <div class="modal fade show" id="bookModal" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content rounded-4 border-0 shadow-lg">
                            ${html}
                        </div>
                    </div>
                </div>
            `;

            document.body.insertAdjacentHTML('beforeend', modalHtml);
            document.body.style.overflow = 'hidden'; // Prevent scrolling

            // Close modal handlers
            const modal = document.getElementById('bookModal');

            modal.addEventListener('click', function(e) {
                if (e.target.id === 'bookModal' || e.target.classList.contains('btn-close')) {
                    closeModal();
                }
            });

            // Close button inside modal
            const closeBtn = modal.querySelector('[data-bs-dismiss="modal"]');
            if (closeBtn) {
                closeBtn.addEventListener('click', closeModal);
            }
        }

                function closeModal() {
            const modal = document.getElementById('bookModal');
            if (modal) {
                modal.classList.add('closing'); // Add closing animation

                setTimeout(() => {
                    modal.remove();
                    document.body.style.overflow = ''; // Restore scrolling
                }, 300); // Wait for animation to finish (300ms)
            }
        }

        function openDetailsModal(bookId) {
            fetch(`/Book/Details?id=${bookId}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(res => res.text())
            .then(html => showModal(html, 'Book Details'))
            .catch(() => showMessage('Error loading book details.'));
        }
    </script>
}