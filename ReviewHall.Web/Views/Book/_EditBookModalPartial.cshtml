@model ReviewHall.Core.Models.EditBookViewModel
<partial name="_ValidationScriptsPartial" />

<form asp-action="Edit" method="post" id="editBookForm">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.BookId)

    <div class="modal-header custom-modal-header text-white">
        <h5 class="modal-title fw-bolder" id="editBookModalLabel">
            <i class="bi bi-pencil-square me-2"></i>Edit Book Details
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body p-4 p-md-5 custom-modal-body">

        <div class="mb-4">
            <label asp-for="Title" class="form-label fw-semibold text-pink-dark">
                <i class="bi bi-book me-2"></i>Book Title
            </label>
            <input asp-for="Title" class="form-control form-control-lg rounded-3" placeholder="Enter book title" />
            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ISBN" class="form-label fw-semibold text-pink-dark">
                <i class="bi bi-upc-scan me-2"></i>ISBN
            </label>
            <input asp-for="ISBN" class="form-control rounded-3" placeholder="Enter ISBN number" />
            <span asp-validation-for="ISBN" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-semibold text-pink-dark">
                <i class="bi bi-text-paragraph me-2"></i>Description
            </label>
            <textarea asp-for="Description" class="form-control rounded-3" rows="4"
                      placeholder="Enter book description"></textarea>
            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="Genre" class="form-label fw-semibold text-pink-dark">
                    <i class="bi bi-tag me-2"></i>Genre
                </label>
                <input asp-for="Genre" class="form-control rounded-3" placeholder="e.g., Fiction, Mystery" />
                <span asp-validation-for="Genre" class="text-danger small mt-1 d-block"></span>
            </div>
            <div class="col-md-6 mb-4">
                <label asp-for="PublishedDate" class="form-label fw-semibold text-pink-dark">
                    <i class="bi bi-calendar-event me-2"></i>Published Date
                </label>
                <input asp-for="PublishedDate" type="date" class="form-control rounded-3" />
                <span asp-validation-for="PublishedDate" class="text-danger small mt-1 d-block"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Author" class="form-label fw-semibold text-pink-dark">
                <i class="bi bi-person me-2"></i>Author
            </label>
            <input asp-for="Author" class="form-control rounded-3" placeholder="Enter author name" />
            <span asp-validation-for="Author" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="mb-4">
            <label asp-for="AuthorProfileImageUrl" class="form-label fw-semibold text-pink-dark">
                <i class="bi bi-person-badge me-2"></i>Author Profile Image URL
            </label>
            <input asp-for="AuthorProfileImageUrl" class="form-control rounded-3"
                   placeholder="https://example.com/author-image.jpg" />
            <small class="form-text text-muted mt-1 d-block">
                <i class="bi bi-info-circle me-1"></i>Optional: Enter a URL for the author's profile picture
            </small>
        </div>

        <div class="mb-4">
            <label asp-for="CoverImageUrl" class="form-label fw-semibold text-pink-dark">
                <i class="bi bi-image me-2"></i>Book Cover Image URL
            </label>
            <input asp-for="CoverImageUrl" class="form-control rounded-3"
                   placeholder="https://example.com/book-cover.jpg" />
            <small class="form-text text-muted mt-1 d-block">
                <i class="bi bi-info-circle me-1"></i>Optional: Enter a URL for the book cover image
            </small>
        </div>

    </div>

    <div class="modal-footer justify-content-center border-0 p-4 pt-0">
        <button type="button" class="btn btn-lg btn-outline-secondary rounded-pill me-3" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-2"></i>Cancel
        </button>
        <button type="submit" class="btn btn-lg custom-pink-btn rounded-pill">
            <i class="bi bi-check-circle me-2"></i>Save Changes
        </button>
    </div>
</form>

<!-- CSS for scrollable modal -->
<style>
    .custom-modal-body {
        max-height: 70vh; 
        overflow-y: auto;
        padding-right: 1rem; 
    }
</style>

<script>
    $(document).ready(function () {
        $('#editBookForm').submit(function (e) {
            if (!$(this).valid()) {
                e.preventDefault();

                var firstError = $('.text-danger:visible:first');
                if (firstError.length) {
                    var modalBody = $(this).closest('.custom-modal-body');

                    if (modalBody.length) {
                        var scrollTo = modalBody.scrollTop() + firstError.position().top - 20; // 20px offset
                        modalBody.animate({ scrollTop: scrollTo }, 500);
                    } else {
                        $('html, body').animate({ scrollTop: firstError.offset().top - 100 }, 500);
                    }
                }
            }
        });
    });
</script>
