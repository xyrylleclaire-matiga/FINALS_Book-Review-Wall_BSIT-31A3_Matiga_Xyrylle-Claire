@model ReviewHall.Core.Entities.Book

<form asp-controller="Book" asp-action="Delete" method="post" id="deleteBookForm">

    <div class="modal-header bg-danger text-white">
        <h5 class="modal-title fw-bold" id="deleteModalLabel">Confirm Deletion</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body p-4 text-center">
        <input type="hidden" name="id" value="@Model.BookId" />

        <i class="bi bi-exclamation-triangle-fill text-danger mb-3" style="font-size: 3rem;"></i>

        <p class="lead mb-2">Are you sure you want to delete the book:</p>
        <h4 class="text-pink-dark fw-bold">"@Model.Title"</h4>
        <p class="text-muted small mt-3">This action cannot be undone and will permanently remove the book and all its copies.</p>
    </div>

    <div class="modal-footer justify-content-center border-0 p-4 pt-0">
        <button type="button" class="btn btn-lg btn-outline-secondary rounded-pill me-3" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-lg btn-danger rounded-pill">Yes, Delete It</button>
    </div>
</form>

<script>
    
</script>