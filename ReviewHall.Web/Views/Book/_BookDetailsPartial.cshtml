@model ReviewHall.Core.Models.BookListViewModel

<!-- Add SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="modal-header">
    <h5 class="modal-title fw-bold">@Model.Title</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <div class="row">
        <div class="col-md-5 text-center">
            <img src="@Model.CoverImageUrl" class="img-fluid rounded shadow-sm mb-3" alt="@Model.Title" />
        </div>

        <div class="col-md-7">
            <p><strong>Author:</strong> @Model.AuthorName</p>
            <p><strong>Genre:</strong> @Model.Genre</p>
            <p><strong>Available Copies:</strong> @Model.AvailableCopies / @Model.TotalCopies</p>
            <hr />
            <p>@Model.Description</p>
        </div>
    </div>

    <hr />

    <!-- ⭐ Overall Reviews and Rating Section -->
    <div class="reviews-section mt-3">
        <h5 class="fw-bold mb-2">Overall Reviews & Rating</h5>

        @if (Model.UserReviews != null && Model.UserReviews.Any())
        {
            var avgRating = Model.UserReviews.Average(r => r.Rating);
            <p><strong>Average Rating:</strong> ⭐ @avgRating.ToString("0.0") / 5</p>

            <div class="review-list mt-3">
                @foreach (var review in Model.UserReviews.OrderByDescending(r => r.ReviewDate))
                {
                    <div class="border rounded p-2 mb-2 bg-light">
                        <strong>@review.UserName</strong> — ⭐ @review.Rating<br />
                        <small class="text-muted">@review.ReviewDate.ToString("MMM dd, yyyy")</small>
                        <p class="mb-0">@review.Comment</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted fst-italic">No reviews yet for this book.</p>
        }
    </div>

    <!-- ✍️ Write a Review (Only for logged-in users, not admins) -->
    @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
    {
        <hr />
        <h6 class="fw-bold">Write a Review</h6>

        <form id="reviewForm" asp-action="SubmitReview" asp-controller="Book" method="post" class="mt-2">
            <input type="hidden" name="BookId" value="@Model.BookId" />

            <div class="mb-2">
                <label class="form-label">Rating:</label>
                <select class="form-select" id="rating" name="Rating" required>
                    <option value="">Select rating</option>
                    @for (int i = 1; i <= 5; i++)
                    {
                        <option value="@i">@i Star(s)</option>
                    }
                </select>
            </div>

            <div class="mb-2">
                <label class="form-label">Comment:</label>
                <textarea class="form-control" id="comment" name="Comment" rows="2" placeholder="Write your thoughts here..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-sm">Submit Review</button>
        </form>

        <script>
            // 🩵 Confirmation popup before submitting review
            document.getElementById("reviewForm").addEventListener("submit", function (e) {
                e.preventDefault();

                const rating = document.getElementById("rating").value;
                const comment = document.getElementById("comment").value;

                if (!rating || !comment) {
                    Swal.fire({
                        icon: "warning",
                        title: "Oops!",
                        text: "Please select a rating and write a comment 😅",
                    });
                    return;
                }

                Swal.fire({
                    title: `Are you sure you want to rate ${rating}/5?`,
                    text: "Your review will be posted immediately.",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Yes, submit it!",
                    cancelButtonText: "No, wait!",
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        this.submit();
                    }
                });
            });
        </script>
    }
    else if (!User.Identity.IsAuthenticated)
    {
        <p class="text-muted mt-2 fst-italic">Please <a href="/Identity/Account/Login">log in</a> to write a review.</p>
    }
</div>

<!-- 🩷 Success / Error Alert after submission -->
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: "success",
            title: "Thank you! 💖",
            text: "@TempData["SuccessMessage"]",
            timer: 3000,
            showConfirmButton: false
        });
    </script>
}
@if (TempData["ErrorMessage"] != null)
{
    <script>
        Swal.fire({
            icon: "error",
            title: "Oops!",
            text: "@TempData["ErrorMessage"]",
        });
    </script>
}
