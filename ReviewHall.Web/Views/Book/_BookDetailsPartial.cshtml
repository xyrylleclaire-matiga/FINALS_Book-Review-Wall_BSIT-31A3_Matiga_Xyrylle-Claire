@model ReviewHall.Core.Models.BookListViewModel

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="modal-header custom-modal-header text-white">
    <h5 class="modal-title fw-bolder">📚 @Model.Title</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4" style="background: linear-gradient(to bottom, #fff9fb, #ffffff);">
    <div class="row g-4">
        <div class="col-md-4 text-center">
            <div class="book-cover-wrapper position-relative">
                <img src="@Model.CoverImageUrl"
                     class="img-fluid rounded-4 shadow-lg"
                     alt="@Model.Title"
                     style="max-height: 350px; object-fit: cover; border: 3px solid var(--color-pink);" />
                <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-pink-custom px-3 py-2 shadow">
                    📖 @Model.AvailableCopies / @Model.TotalCopies Available
                </span>
            </div>
        </div>

        <div class="col-md-8">
            <div class="book-info-card p-3 rounded-3" style="background-color: #fff0f5;">
        
                <div class="mb-3 d-flex align-items-center">
                    <i class="bi bi-person-circle text-pink-dark me-2" style="font-size: 1.5rem;"></i>
                    <div>
                        <small class="text-muted d-block">Written by</small>
                        <strong class="text-pink-dark">@Model.AuthorName</strong>
                    </div>
                </div>

                <div class="mb-3">
                    <span class="badge bg-pink-custom px-3 py-2" style="font-size: 0.95rem;">
                        🏷️ @Model.Genre
                    </span>
                </div>
                <div class="mt-3">
                    <h6 class="text-pink-dark fw-bold mb-2">📝 Description</h6>
                    <p class="text-muted" style="line-height: 1.7; text-align: justify;">
                        @Model.Description
                    </p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" style="border-top: 2px solid var(--color-accent);" />

    <div class="reviews-section">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold text-pink-dark mb-0">
                <i class="bi bi-star-fill text-warning me-2"></i>Reviews & Ratings
            </h5>
            @if (Model.UserReviews != null && Model.UserReviews.Any())
            {
                var avgRating = Model.UserReviews.Average(r => r.Rating);
                <div class="rating-badge px-4 py-2 rounded-pill"
                     style="background: linear-gradient(135deg, #ffd700, #ffed4e); color: #333; font-weight: bold; font-size: 1.1rem;">
                    ⭐ @avgRating.ToString("0.0") / 5
                </div>
            }
        </div>

        @if (Model.UserReviews != null && Model.UserReviews.Any())
        {
            <div class="review-list mt-3" style="max-height: 400px; overflow-y: auto;">
                @foreach (var review in Model.UserReviews.OrderByDescending(r => r.ReviewDate))
                {
                    <div class="review-card border-0 rounded-3 p-3 mb-3 shadow-sm"
                         style="background-color: #fff; border-left: 4px solid var(--color-pink) !important;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong class="text-pink-dark">
                                    <i class="bi bi-person-fill me-1"></i>@review.UserName
                                </strong>
                                <div class="mt-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted"></i>
                                        }
                                    }
                                    <span class="ms-2 text-muted small">(@review.Rating/5)</span>
                                </div>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>@review.ReviewDate.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                        <p class="mb-0 text-muted fst-italic">"@review.Comment"</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="bi bi-chat-left-text text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted fst-italic mt-2">No reviews yet. Be the first to review this book! 📝</p>
            </div>
        }
    </div>
    @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
    {
        <hr class="my-4" style="border-top: 2px solid var(--color-accent);" />

        <div class="write-review-section p-4 rounded-3" style="background-color: #fff0f5;">
            <h6 class="fw-bold text-pink-dark mb-3">
                <i class="bi bi-pencil-square me-2"></i>Share Your Thoughts
            </h6>

            <form id="reviewForm" asp-action="SubmitReview" asp-controller="Book" method="post">
                <input type="hidden" name="BookId" value="@Model.BookId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold text-pink-dark">Your Rating:</label>
                    <select class="form-select form-select-lg" id="rating" name="Rating" required
                            style="border: 2px solid var(--color-accent);">
                        <option value="">⭐ Select your rating</option>
                        @for (int i = 1; i <= 5; i++)
                        {
                            <option value="@i">@String.Join("", Enumerable.Repeat("⭐", i)) (@i Star@(i > 1 ? "s" : ""))</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-pink-dark">Your Review:</label>
                    <textarea class="form-control" id="comment" name="Comment" rows="4"
                          placeholder="What did you think about this book? Share your experience..."
                          required style="border: 2px solid var(--color-accent);"></textarea>
                </div>

                <button type="submit" class="btn btn-lg custom-pink-btn rounded-pill px-4">
                    <i class="bi bi-send-fill me-2"></i>Submit Review
                </button>
            </form>

            <script>
                document.getElementById("reviewForm").addEventListener("submit", function (e) {
                    e.preventDefault();

                    const rating = document.getElementById("rating").value;
                    const comment = document.getElementById("comment").value;

                    if (!rating || !comment) {
                        Swal.fire({
                            icon: "warning",
                            title: "Oops!",
                            text: "Please select a rating and write a comment 😊",
                            confirmButtonColor: "#ec407a"
                        });
                        return;
                    }

                    Swal.fire({
                        title: `Rate this book ${rating}/5 stars?`,
                        text: "Your review will be posted immediately.",
                        icon: "question",
                        showCancelButton: true,
                        confirmButtonText: "Yes, submit it! 💖",
                        cancelButtonText: "Not yet",
                        confirmButtonColor: "#ec407a",
                        cancelButtonColor: "#9e9e9e",
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            this.submit();
                        }
                    });
                });
            </script>
        </div>
    }
    else if (!User.Identity.IsAuthenticated)
    {
        <div class="alert alert-info border-0 rounded-3 text-center mt-4"
             style="background: linear-gradient(135deg, #e3f2fd, #bbdefb);">
            <i class="bi bi-info-circle-fill me-2"></i>
            Please <a href="/Identity/Account/Login" class="text-decoration-none fw-bold" style="color: var(--color-deep-pink);">log in</a> to write a review 📝
        </div>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: "success",
            title: "Thank you! 💖",
            text: "@TempData["SuccessMessage"]",
            timer: 3000,
            showConfirmButton: false,
            confirmButtonColor: "#ec407a"
        });
    </script>
}
@if (TempData["ErrorMessage"] != null)
{
    <script>
        Swal.fire({
            icon: "error",
            title: "Oops!",
            text: "@TempData["ErrorMessage"]",
            confirmButtonColor: "#ec407a"
        });
    </script>
}