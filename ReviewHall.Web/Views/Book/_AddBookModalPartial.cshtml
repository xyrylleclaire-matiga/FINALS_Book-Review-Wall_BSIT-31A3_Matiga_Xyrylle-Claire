@model ReviewHall.Core.Entities.Book


<style>
    .bg-pink-custom {
        background-color: #ec407a !important; 
    }

    .btn-pink-custom {
        background-color: #ec407a;
        color: white;
        border: none;
        transition: background-color 0.3s ease;
    }

        .btn-pink-custom:hover {
            background-color: #d81b60; 
            color: white;
        }

    .btn-close-white {
        filter: invert(1);
    }
</style>

<div class="modal-content">
    <div class="modal-header bg-pink-custom text-white">
        <h5 class="modal-title fw-bold">
            <i class="bi bi-plus-circle me-2"></i>Add New Book
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <form id="addBookForm" asp-controller="Book" asp-action="Create" method="post">
        <div class="modal-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter book title" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ISBN" class="form-label fw-semibold">ISBN <span class="text-danger">*</span></label>
                    <input asp-for="ISBN" class="form-control" placeholder="e.g., 978-0-123456-78-9" required />
                    <span asp-validation-for="ISBN" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="AuthorName" class="form-label fw-semibold">Author Name <span class="text-danger">*</span></label>
                    <input asp-for="AuthorName" class="form-control" placeholder="Enter author name" required />
                    <span asp-validation-for="AuthorName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Genre" class="form-label fw-semibold">Genre <span class="text-danger">*</span></label>
                    <select asp-for="Genre" class="form-select" required>
                        <option value="">-- Select Genre --</option>
                        <option value="Fiction">Fiction</option>
                        <option value="Non-Fiction">Non-Fiction</option>
                        <option value="Mystery">Mystery</option>
                        <option value="Thriller">Thriller</option>
                        <option value="Romance">Romance</option>
                        <option value="Science Fiction">Science Fiction</option>
                        <option value="Fantasy">Fantasy</option>
                        <option value="Biography">Biography</option>
                        <option value="History">History</option>
                        <option value="Self-Help">Self-Help</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PublishedDate" class="form-label fw-semibold">Published Date <span class="text-danger">*</span></label>
                    <input asp-for="PublishedDate" type="date" class="form-control" required />
                    <span asp-validation-for="PublishedDate" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CoverImageUrl" class="form-label fw-semibold">Cover Image URL <span class="text-danger">*</span></label>
                    <input asp-for="CoverImageUrl" class="form-control" placeholder="https://example.com/cover.jpg" required />
                    <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="AuthorProfileImageUrl" class="form-label fw-semibold">Author Image URL</label>
                    <input asp-for="AuthorProfileImageUrl" class="form-control" placeholder="https://example.com/author.jpg (Optional)" />
                    <span asp-validation-for="AuthorProfileImageUrl" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="TotalCopies" class="form-label fw-semibold">Total Copies <span class="text-danger">*</span></label>
                    <input asp-for="TotalCopies" type="number" class="form-control" min="0" value="1" required />
                    <span asp-validation-for="TotalCopies" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="AvailableCopies" class="form-label fw-semibold">Available Copies <span class="text-danger">*</span></label>
                    <input asp-for="AvailableCopies" type="number" class="form-control" min="0" value="1" required />
                    <span asp-validation-for="AvailableCopies" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter book description/summary" required></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="bi bi-x-circle me-1"></i>Cancel
            </button>
            <button type="submit" class="btn btn-pink-custom">
                <i class="bi bi-plus-circle me-1"></i>**Add Book**
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}