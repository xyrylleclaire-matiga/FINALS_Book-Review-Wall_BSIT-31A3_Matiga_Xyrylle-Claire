@model IEnumerable<Library_Management.Models.BookListViewModel>

@{
    ViewData["Title"] = "Books";
}

<!-- IDINAGDAG: Mas malaking font at pink accent -->
<h1 class="mb-4 fw-bold text-pink-dark">
    <i class="bi bi-book-half me-2"></i> Book Library
</h1>

<!-- BOOK CARDS GRID -->
<!-- Nagdagdag ng g-4 (gap) para maging mas maluwag -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4">
    <!-- ADD BOOK CARD (First Card) -->
    <div class="col">
        <a href="javascript:void(0);"
           onclick="openAddModal()"
           class="card h-100 shadow-sm border-2 border-dashed d-flex align-items-center justify-content-center text-decoration-none add-card bg-white hover-border-pink">
            <div class="text-center p-4">
                <i class="bi bi-plus-circle text-pink-accent" style="font-size: 3rem;"></i>
                <p class="mt-2 text-pink-dark fw-semibold">Add New Book</p>
            </div>
        </a>
    </div>

    @foreach (var book in Model)
    {
        <div class="col">
            <!-- Book Card -->
            <div class="card book-card h-100 shadow-sm border-0 rounded-lg">

                <!-- Action Buttons (Edit/Details/Delete) -->
                <div class="book-actions">
                    <!-- Edit -->
                    <a href="javascript:void(0);"
                       class="action-btn edit-btn"
                       title="Edit Book"
                       onclick="openEditModal('@book.BookId')">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    <!-- Details -->
                    <a asp-action="Details" asp-route-id="@book.BookId" class="action-btn details-btn" title="Details">
                        <i class="bi bi-info-circle"></i>
                    </a>
                    <!-- Delete -->
                    <a href="javascript:void(0);"
                       onclick="openDeleteModal('/Book/DeleteModal?id=@book.BookId', 'Delete Book')"
                       class="action-btn delete-btn"
                       title="Delete Book">
                        <i class="bi bi-trash"></i>
                    </a>

                </div>

                <!-- Cover Image -->
                <img src="@book.CoverImageUrl"
                     class="card-img-top book-cover"
                     alt="@book.Title"
                     style="height: 200px; object-fit: cover; background-color: #f7f7f7;"
                     onerror="this.onerror=null; this.src='https://placehold.co/400x200/FADADD/333?text=No+Cover';" />

                <!-- Card Body -->
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <!-- Title (Shortened) -->
                        <h6 class="card-title text-truncate fw-bold text-pink-dark" title="@book.Title">@book.Title</h6>
                        <!-- Author -->
                        <p class="text-muted mb-1 text-truncate small">
                            Author: **@book.AuthorName**
                        </p>
                    </div>
                    <!-- Footer Info -->
                    <p class="mt-2 small text-secondary">
                        @book.Genre | Copies: **@book.AvailableCopies** / **@book.TotalCopies**
                    </p>
                </div>
            </div>
        </div>
    }
</div>

<!-- COMMON MODAL STRUCTURE (Huwag i-delete) -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal content will be loaded here via AJAX -->
            <div class="modal-header bg-pink-accent">
                <h5 class="modal-title text-pink-dark fw-bold" id="exampleModalLabel">Loading...</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center p-5"><i class="bi bi-arrow-clockwise spin" style="font-size: 2rem;"></i> Loading form...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Use a consistent way to handle errors and modals (Custom Message Box instead of alert)
        function showMessage(message) {
            // Since we cannot use alert(), let's make a simple modal replacement notification
            console.error(message);
            // Implement a custom toast or notification here if preferred
            alert(message); // Fallback to alert for now
        }

        function openAddModal() {
            fetch(`/Book/AddModal`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Error loading Add Book form.');
                    }
                    return response.text();
                })
                .then(html => {
                    // Update the modal content
                    document.querySelector('#exampleModal .modal-content').innerHTML = html;

                    // Show the Bootstrap modal
                    let modal = new bootstrap.Modal(document.getElementById('exampleModal'));
                    modal.show();
                })
                .catch(error => {
                    showMessage(error.message);
                });
        }

        function openEditModal(bookId) {
            fetch(`/Book/EditModal?id=${encodeURIComponent(bookId)}`)
                .then(response => {
                    if (!response.ok) {
                        // Check for 404 specifically
                        if (response.status === 404) {
                            throw new Error('Book not found.');
                        }
                        throw new Error('Error loading Edit Book form.');
                    }
                    return response.text();
                })
                .then(html => {
                    document.querySelector('#exampleModal .modal-content').innerHTML = html;
                    let modal = new bootstrap.Modal(document.getElementById('exampleModal'));
                    modal.show();
                })
                .catch(error => {
                    showMessage(error.message);
                });
        }

        // Gamit pa rin ang JQuery para sa DeleteModal (consistent sa original code mo)
        function openDeleteModal(url, title) {
            $.ajax({
                url: url,
                type: 'GET',
                success: function (data) {
                    $('#exampleModal .modal-content').html(data);
                    $('#exampleModal .modal-title').text(title); // Use correct element selector
                    $('#exampleModal').modal('show');
                },
                error: function () {
                    showMessage('Error loading delete confirmation.');
                }
            });
        }

        // Delete confirmation function
        function confirmDelete(id) {
            fetch(`/Book/Delete/${id}`, {
                method: 'DELETE'
            })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    showMessage('Failed to delete the book. The book might not exist or the server returned an error.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showMessage('An error occurred during deletion.');
            });
        }

        // Form Submission Handler for Add and Edit
        document.addEventListener("submit", function (e) {
            const form = e.target;

            if (form.matches("#editBookForm") || form.matches("#addBookForm")) {
                e.preventDefault();

                // Simple form data encoding
                const formData = new FormData(form);
                const urlSearchParams = new URLSearchParams();
                for (const pair of formData) {
                    urlSearchParams.append(pair[0], pair[1]);
                }

                fetch(form.action, {
                    method: form.method,
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded' // Mahalaga para sa MVC binding
                    },
                    body: urlSearchParams
                })
                .then(response => {
                    if (response.ok) {
                        // Success: Reload the page to see the updated list
                        location.reload();
                    } else if (response.status === 400) {
                        // Handle Validation Errors (If controller returns BadRequest(ModelState))
                        return response.json().then(errorData => {
                            // Display the validation errors somehow (e.g., re-render form with errors)
                            showMessage('Validation failed. Please check the form.');
                            console.error('Validation Errors:', errorData);
                        });
                    } else {
                        throw new Error('Server returned an error status: ' + response.status);
                    }
                })
                .catch(error => {
                    showMessage('Error saving changes: ' + error.message);
                });
            }
        });
    </script>
}