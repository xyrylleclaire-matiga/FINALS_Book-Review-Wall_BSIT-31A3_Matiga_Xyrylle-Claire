@model Library_Management.Models.BookListViewModel
@* NOTE: Assuming BookListViewModel contains necessary fields like Description and an average rating property.
    If you need to display a list of reviews, you should ideally use a dedicated BookDetailsViewModel
    that includes a list of Review objects. For this code, we'll use placeholder data/properties.
*@

<div class="modal-header modal-header-themed">
    <h5 class="modal-title fw-bold text-white">@Model.Title</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4">
    <div class="row g-4 align-items-start">
        <div class="col-md-4 text-center">
            <img src="@Model.CoverImageUrl"
                 alt="@Model.Title"
                 class="img-fluid rounded-4 shadow-lg book-details-cover"
                 onerror="this.onerror=null; this.src='https://placehold.co/300x400/FADADD/333?text=No+Cover';" />

            @* ⭐️ Placeholder for Average Rating and Count *@
            <div class="mt-3">
                <span class="fs-5 fw-bold" style="color: var(--color-deep-pink);">
                    4.5
                    <i class="bi bi-star-fill pink-theme rated-star me-1"></i>
                </span>
                <span class="text-muted small">(120 Reviews)</span>
            </div>
        </div>

        <div class="col-md-8">
            <dl class="row mb-0">
                <dt class="col-sm-4 fw-semibold">ISBN</dt>
                <dd class="col-sm-8">@Model.ISBN</dd>

                <dt class="col-sm-4 fw-semibold">Author</dt>
                <dd class="col-sm-8 d-flex align-items-center">
                    @Model.AuthorName
                    @if (!string.IsNullOrEmpty(Model.AuthorProfileImageUrl))
                    {
                        <img src="@Model.AuthorProfileImageUrl"
                             class="rounded-circle ms-2"
                             style="width: 30px; height: 30px; object-fit: cover;"
                             alt="Author Profile" />
                    }
                </dd>

                <dt class="col-sm-4 fw-semibold">Genre</dt>
                <dd class="col-sm-8"><span class="badge bg-pink-light text-pink-dark">@Model.Genre</span></dd>

                <dt class="col-sm-4 fw-semibold">Published</dt>
                <dd class="col-sm-8">@Model.PublishedDate?.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4 fw-semibold">Copies</dt>
                <dd class="col-sm-8">@Model.AvailableCopies / @Model.TotalCopies</dd>
            </dl>

            <hr class="mt-4" />

            @* 📝 Tabs for Description and Reviews *@
            <ul class="nav nav-tabs" id="bookTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active tab-link-pink" id="desc-tab" data-bs-toggle="tab" data-bs-target="#description-pane" type="button" role="tab" aria-controls="description-pane" aria-selected="true">Description</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tab-link-pink" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews-pane" type="button" role="tab" aria-controls="reviews-pane" aria-selected="false">Reviews & Add</button>
                </li>
            </ul>

            <div class="tab-content pt-3" id="bookTabsContent">

                @* 📚 Description Tab Pane *@
                <div class="tab-pane fade show active" id="description-pane" role="tabpanel" aria-labelledby="desc-tab">
                    <p class="text-muted">@Model.Description</p>
                </div>

                @* ⭐️ Reviews Tab Pane *@
                <div class="tab-pane fade" id="reviews-pane" role="tabpanel" aria-labelledby="reviews-tab">

                    @* ✍️ Review Submission Form *@
                    <h6 class="fw-bold mb-3" style="color: var(--color-deep-pink);">Leave Your Review</h6>
                    <form id="addReviewForm" action="/Book/AddReview" method="post" class="p-3 border rounded-3 bg-light-pink-bg mb-4">
                        <input type="hidden" name="BookId" value="@Model.BookId" />

                        <div class="mb-3">
                            <label for="ratingInput" class="form-label fw-semibold small">Your Rating</label>
                            <div id="ratingStars" class="star-rating">
                                <i class="bi bi-star-fill text-muted" data-rating="1"></i>
                                <i class="bi bi-star-fill text-muted" data-rating="2"></i>
                                <i class="bi bi-star-fill text-muted" data-rating="3"></i>
                                <i class="bi bi-star-fill text-muted" data-rating="4"></i>
                                <i class="bi bi-star-fill text-muted" data-rating="5"></i>
                            </div>
                            <input type="hidden" name="Rating" id="ratingInput" value="0" required />
                        </div>

                        <div class="mb-3">
                            <label for="reviewText" class="form-label fw-semibold small">Review (Optional)</label>
                            <textarea class="form-control" id="reviewText" name="ReviewText" rows="2"></textarea>
                        </div>

                        <button type="submit" class="btn btn-pink btn-sm w-100 mt-2">Submit Review</button>
                    </form>

                    @* 📄 Existing Reviews (Placeholder List) *@
                    <h6 class="fw-bold mb-3 mt-4 text-secondary">Recent Reviews (3)</h6>
                    <div class="review-list">
                        <p class="text-muted small">
                            <i class="bi bi-star-fill rated-star pink-theme"></i>
                            <i class="bi bi-star-fill rated-star pink-theme"></i>
                            <i class="bi bi-star-fill rated-star pink-theme"></i>
                            <i class="bi bi-star-fill rated-star pink-theme"></i> (User 1): Excellent read!
                        </p>
                        <p class="text-muted small border-top pt-2 mt-2">
                            <i class="bi bi-star-fill rated-star pink-theme"></i>
                            <i class="bi bi-star-fill rated-star pink-theme"></i>
                            <i class="bi bi-star-fill rated-star pink-theme"></i>
                            <i class="bi bi-star-fill rated-star pink-theme"></i>
                            <i class="bi bi-star-fill rated-star pink-theme"></i> (User 2): Five stars, highly recommend.
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-outline-pink" data-bs-dismiss="modal">
        <i class="bi bi-arrow-left"></i> Close
    </button>
    <button type="button" class="btn btn-pink" onclick="openEditModal('@Model.BookId')">
        <i class="bi bi-pencil-square"></i> Manage Book
    </button>
</div>