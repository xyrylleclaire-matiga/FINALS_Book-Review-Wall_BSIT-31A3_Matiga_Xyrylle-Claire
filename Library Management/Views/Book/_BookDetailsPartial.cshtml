@model Library_Management.Models.BookListViewModel

<div class="modal-header">
    <h5 class="modal-title fw-bold">@Model.Title</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <div class="row">
        <div class="col-md-5 text-center">
            <img src="@Model.CoverImageUrl" class="img-fluid rounded shadow-sm mb-3" alt="@Model.Title" />
        </div>
        <div class="col-md-7">
            <p><strong>Author:</strong> @Model.AuthorName</p>
            <p><strong>Genre:</strong> @Model.Genre</p>
            <p><strong>Available Copies:</strong> @Model.AvailableCopies / @Model.TotalCopies</p>
            <hr />
            <p>@Model.Description</p>
        </div>
    </div>
</div>
