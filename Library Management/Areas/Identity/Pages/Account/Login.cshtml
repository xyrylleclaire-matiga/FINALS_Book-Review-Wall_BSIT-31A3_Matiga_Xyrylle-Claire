@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    // Check if external logins exist to adjust layout
    var hasExternalLogins = (Model.ExternalLogins?.Count ?? 0) > 0;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">

        <div class="p-4 p-md-5 bg-white border rounded-3 shadow-lg auth-container">
            <h1 class="text-center mb-4 fw-bold text-pink-dark">
                <i class="bi bi-lock-fill me-2"></i> @ViewData["Title"]
            </h1>

            <section>
                <form id="account" method="post">
                    <h2 class="h5 mb-3 fw-semibold text-center text-secondary">
                        Sign in to your account
                    </h2>

                    <hr class="mb-4" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="checkbox mb-3 form-check">
                        <label asp-for="Input.RememberMe" class="form-check-label small text-secondary">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>

                    <div class="d-grid mb-3">
                        <button id="login-submit" type="submit" class="btn btn-lg btn-pink fw-bold">Log in</button>
                    </div>

                    <div class="d-flex justify-content-between flex-wrap small">
                        <p class="m-0">
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-pink">Forgot password?</a>
                        </p>
                        <p class="m-0">
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-pink">Register as a new user</a>
                        </p>
                    </div>
                    <p class="mt-2 text-center small">
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-secondary">Resend email confirmation</a>
                    </p>
                </form>
            </section>
        </div>

        @if (hasExternalLogins)
        {
            <div class="mt-4 p-4 bg-light-pink-bg border rounded-3 shadow-sm text-center">
                <section>
                    <h3 class="h6 fw-semibold text-pink-dark">Or log in with:</h3>
                    <hr class="my-3" />

                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-secondary m-1" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                    <i class="bi bi-globe me-1"></i> @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                </section>
            </div>
        }
        else
        {
            <div class="mt-4 text-center small text-muted">
                <p>No external authentication services configured.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}